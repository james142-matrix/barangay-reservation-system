APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_LOG_DIR=C:\xampp\htdocs\barangay-reservation-system\logs\app

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=barangay
DB_USER=root
DB_PASS=

SESSION_NAME=barangay_session
SESSION_IDLE_TIMEOUT_SEC=1800
CSRF_HEADER=X-CSRF-Token
LOGIN_RATE_LIMIT_WINDOW_SEC=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_LOCKOUT_SEC=900

MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Barangay Reservation System

GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_SENDER=

FORGOT_PASSWORD_DEBUG_RETURN_CODE=false
